# Copy this file's contents into Vercel's "Environment Variables" settings.
# Do NOT put your real keys in this file if you upload it to GitHub -
# this is just a template showing what two values you need.

NEXT_PUBLIC_SUPABASE_URL=your-project-url-goes-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-goes-here
